# Node 22+. Keep this file as .env on your own device.
# For a collection, set the directory containing all 15 repository folders.
PROJECTS_ROOT=./projects
PORT=8787
# Optional absolute browser executable. Otherwise installed Chrome is used.
CHROME=
PYTHON=python
PROJECT_WORKSPACE=./workspace

# SMTP account. App passwords can be used when supported by your provider.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# TMDB API Read Access Token
TMDB_API_TOKEN=

# Perfect Corp / YouCam API key
YOUCAM_API_KEY=
